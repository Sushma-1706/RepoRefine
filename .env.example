# GitHub token used server-side for profile audits and repository context retrieval.
GITHUB_TOKEN=

# Optional AI provider settings. The repository assistant remains evidence-grounded without them.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Python profile-analysis backend.
BACKEND_API_URL=

# Repository assistant cache and retrieval limits.
REPOSITORY_CONTEXT_TTL_MS=300000
REPOSITORY_CONTEXT_MAX_FILES=18
REPOSITORY_CONTEXT_MAX_FILE_BYTES=75000
